# Supabase Configuration
# Required: Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co

# Required: Secret / service_role key for backend operations.
# Can be the modern secret key or legacy service_role JWT key.
# This key is only accessed on the server side and must never be committed.
SUPABASE_SECRET_KEY=your_supabase_secret_key

# Optional alternative name if your project uses legacy naming:
# SUPABASE_SERVICE_ROLE_KEY=your_legacy_service_role_key

# Server settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Triage & Auto-Scheduling — Google Gemini API
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.0-flash
AI_ENABLED=true

