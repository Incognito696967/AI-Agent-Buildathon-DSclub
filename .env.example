# ==============================================================================
# Intelligent Medical Appointment Coordination - Environment Configuration
# ==============================================================================
# Copy this file to backend/.env and frontend/.env (or set environment variables)

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------
# Supabase Project URL (e.g., https://your-project-ref.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Secret Key (service_role secret key for backend server operations)
# NOTE: Supports modern secret keys (sb_secret_...) or legacy JWT service_role keys.
# NEVER expose this key to frontend or client-side code!
SUPABASE_SECRET_KEY=your_supabase_secret_or_service_role_key

# Optional alternative variable for legacy configurations
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# AI Triage & Auto-Scheduling Configuration
GEMINI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-2.0-flash
AI_ENABLED=true

# Backend Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173


# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env)
# ------------------------------------------------------------------------------
# Base API URL pointing to the FastAPI backend v1 router
VITE_API_BASE_URL=http://localhost:8000/api/v1
